{
  "name": "learn-beyond-names",
  "version": "1.0.0",
  "description": "Anonymous skill exchange platform for college students",
  "main": "index.html",
  "private": true,
  "scripts": {
    "dev": "live-server --port=3000 --open=/index.html",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./dist/tailwind-output.css",
    "watch": "tailwindcss -i ./src/tailwind-input.css -o ./dist/tailwind-output.css --watch",
    "build": "npm run build:css",
    "preview": "live-server --port=3000 --open=/index.html"
  },
  "keywords": [
    "anonymous",
    "skill-exchange",
    "education",
    "college"
  ],
  "author": "Jai Gudivada",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "live-server": "^1.2.2"
  }
}
